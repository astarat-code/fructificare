# Normalise les fins de ligne : LF dans le dépôt, quelle que soit la machine.
* text=auto eol=lf

# Scripts Windows : doivent rester en CRLF pour PowerShell et cmd.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaires : jamais convertis, jamais « diffés » en texte.
*.png binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary

# Fichiers verrouillés : bruyants dans les revues, et jamais fusionnés à la main.
package-lock.json linguist-generated=true
Cargo.lock linguist-generated=true

# Le manuel est du code JavaScript, pas de la documentation : qu'il compte comme tel.
docs/manuel/** linguist-documentation=true
