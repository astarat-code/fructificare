# Build de production
# INLINE_RUNTIME_CHUNK=false : sans cela CRA injecte le runtime webpack en <script> inline,
# ce que la CSP « script-src 'self' » (src-tauri/tauri.conf.json) bloquerait.
INLINE_RUNTIME_CHUNK=false
# Les source maps ne servent qu'au débogage : les exclure allège nettement le binaire.
GENERATE_SOURCEMAP=false

# Serveur de développement (npm start) — jamais utilisé par l'application de bureau.
# HOST=127.0.0.1 empêche l'exposition du serveur de dev sur le réseau local.
HOST=127.0.0.1
BROWSER=none
